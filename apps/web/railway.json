{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @post-oak/web build",
    "watchPatterns": ["apps/web/**", "packages/contracts/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @post-oak/web start",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
