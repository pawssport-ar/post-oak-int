{
  "name": "@post-oak/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API for Post Oak Business Banking, backed by a mock banking-as-a-service provider.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @post-oak/contracts build && tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@post-oak/contracts": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "supertest": "^7.1.4",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
