# Reference only: nothing loads this file. Set these in the environment, for example
# in Railway's service variables. Local development needs neither of them.

# Web app: where the backend-for-frontend proxy finds the API. Read at runtime.
# Defaults to http://localhost:4000.
API_URL=http://localhost:4000

# Both apps: the port to listen on. Railway sets it for each service.
# Defaults to 3000 for the web app and 4000 for the API.
PORT=4000
